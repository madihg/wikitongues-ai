{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:sql": "prisma migrate diff --from-empty --to-schema-datamodel ./prisma/schema.prisma --script",
    "seed": "tsx prisma/seed.ts",
    "seed:prompt-bank": "tsx prisma/seed-prompt-bank.ts",
    "seed:longform": "tsx prisma/seed-prompt-longform.ts",
    "seed:rag": "tsx prisma/seed-rag.ts",
    "seed:rag-igala": "tsx prisma/seed-rag-igala.ts",
    "seed:arena": "tsx prisma/seed-arena.ts",
    "seed:outputs": "tsx prisma/seed-outputs.ts",
    "create:annotators": "tsx prisma/create-annotators.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.45",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/openai": "^3.0.29",
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/client": "^6.19.2",
    "ai": "^6.0.89",
    "bcryptjs": "^3.0.3",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "openai": "^6.22.0",
    "prisma": "^6.19.2",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2.1.8",
    "yaml": "^2.8.2"
  }
}
