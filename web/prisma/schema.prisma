generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// Wikitongues AI v2 - Igala pilot.
// Backed by Halim's Supabase project (schema selected via ?schema=wikitongues in DATABASE_URL).
// pgvector powers RAG similarity search; RAG falls back to keyword search if unavailable.

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

// ─── Roles & people ──────────────────────────────────────────

enum UserRole {
  LEARNER
  ANNOTATOR
  RESEARCHER
}

enum ExpertiseLevel {
  native
  heritage
  fluent
  conversational
}

// ─── The 8 evaluation buckets ────────────────────────────────
// Each bucket is three things at once: a prompt category, a rubric axis,
// and a data-collection target. Canonical taxonomy for the whole platform.
enum EvalBucket {
  orthography // 1 spelling & diacritics
  grammar_tone // 2 grammar, morphology, tone
  lexicon_disambig // 3 lexicon & disambiguation (interference: genetically Yoruba/Igbo; observed: Idoma)
  dialectal_fidelity // 4 no collapse to a prestige standard
  register_honorifics // 5 register & honorifics
  idioms_metaphor // 6 idioms, metaphor, floating motifs
  cultural_values // 7 cultural knowledge & values (taboo/sacred)
  authenticity // 8 authenticity vs translationese
}

enum DifficultyLevel {
  basic
  intermediate
  advanced
}

enum PromptSplit {
  train // usable for training-set export
  dev // calibration / tuning
  test // held-out benchmark; NEVER exported for training
}

enum HandoffStatus {
  pending
  in_review
  approved
  corrected
  rejected
}

enum VerificationStatus {
  seed
  single_annotator
  multi_annotator_verified
  expert_reviewed
}

// Holistic cost ledger categories (the instrument's spend).
enum CostCategory {
  finetune // Together / OpenAI fine-tune training runs
  eval_generation // candidate answer generation on the held-out bank
  judge // LLM-as-judge triage calls
  inference // ad-hoc / learner-tutor inference
  credits // money leaving the card: credit purchases and invoices (receipts)
  other
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(ANNOTATOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  languages           AnnotatorLanguage[]
  pairwiseComparisons PairwiseComparison[]
  rubricScores        RubricScore[]
  rubricAxisScores    RubricAxisScore[]
  outputEdits         OutputEdit[]
  coldAuthorAnswers   ColdAuthorAnswer[]
  promptFlags         PromptFlag[]
  handoffReviews      HandoffItem[]        @relation("ReviewedBy")
  promptsCreated      Prompt[]             @relation("CreatedBy")
  promptsEdited       PromptEdit[]
}

model AnnotatorLanguage {
  id             String         @id @default(cuid())
  userId         String
  language       String         @default("igala")
  expertiseLevel ExpertiseLevel

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, language])
}

// ─── Prompts & the held-out bank ─────────────────────────────

model Prompt {
  id                      String          @id @default(cuid())
  promptId                String          @unique // e.g. ig_orth_001
  bucket                  EvalBucket
  language                String          @default("igala")
  text                    String
  sourceLanguage          String?
  targetCulture           String?
  expectedCulturalContext String?
  difficultyLevel         DifficultyLevel @default(intermediate)
  split                   PromptSplit     @default(train)
  isHoldout               Boolean         @default(false) // convenience flag; true == split test
  provenance              String? // e.g. community_authored, must NOT be Igala-Wikipedia for held-out
  createdById             String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  createdBy         User?              @relation("CreatedBy", fields: [createdById], references: [id])
  edits             PromptEdit[]
  modelOutputs      ModelOutput[]
  coldAuthorAnswers ColdAuthorAnswer[]
  flags             PromptFlag[]

  @@index([language, bucket])
  @@index([split])
}

model PromptEdit {
  id        String   @id @default(cuid())
  promptId  String
  userId    String
  fieldName String
  oldValue  String?
  newValue  String
  createdAt DateTime @default(now())

  prompt Prompt @relation(fields: [promptId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

// ─── Model generations ───────────────────────────────────────

model ModelOutput {
  id               String      @id @default(cuid())
  promptId         String
  model            String // denormalized label e.g. "claude", "gemma"
  modelId          String // full provider model id
  candidateModelId String? // arena candidate that produced this (null for legacy/manual)
  evalRunId        String? // eval run that generated this output
  bucket           EvalBucket? // denormalized from prompt for fast filtering
  outputText       String
  ragContextIds    String[]    @default([])
  tokenCountIn     Int?
  tokenCountOut    Int?
  latencyMs        Int?
  epochId          String?
  runId            String?
  isDemo           Boolean     @default(false) // generated inside a demo/testing session
  demoSessionId    String?
  createdAt        DateTime    @default(now())

  prompt           Prompt               @relation(fields: [promptId], references: [id])
  candidateModel   CandidateModel?      @relation(fields: [candidateModelId], references: [id])
  evalRun          EvalRun?             @relation(fields: [evalRunId], references: [id])
  epoch            Epoch?               @relation(fields: [epochId], references: [id])
  pairwiseAsA      PairwiseComparison[] @relation("ModelA")
  pairwiseAsB      PairwiseComparison[] @relation("ModelB")
  rubricScores     RubricScore[]
  rubricAxisScores RubricAxisScore[]
  edits            OutputEdit[]

  @@index([candidateModelId])
  @@index([evalRunId])
}

// ─── Human signal: pairwise, rubric, edits ───────────────────

model PairwiseComparison {
  id             String     @id @default(cuid())
  promptId       String
  bucket         EvalBucket?
  modelOutputAId String
  modelOutputBId String
  winner         String // "a" | "b" | "tie" | "both_inadequate"
  confidence     Int? // 1-4 self-reported confidence in the pick
  explanation    String
  // Failure diagnostics per output — WHY an answer is wrong, as a fast
  // multi-select. Tag keys are CONFIG (FAILURE_TAGS in src/lib/failure-tags.ts),
  // not schema, so the set can change without a migration. Collected on the
  // both-inadequate path (both sides) and on the LOSING side when a winner is
  // picked; additive to the required written explanation, never a replacement.
  failureTagsA   String[]   @default([])
  failureTagsB   String[]   @default([])
  annotatorId    String
  epochId        String?
  evalRunId      String?
  isDemo         Boolean    @default(false) // collected in a demo/testing session — never exported
  demoSessionId  String?
  createdAt      DateTime   @default(now())

  modelOutputA ModelOutput @relation("ModelA", fields: [modelOutputAId], references: [id])
  modelOutputB ModelOutput @relation("ModelB", fields: [modelOutputBId], references: [id])
  annotator    User        @relation(fields: [annotatorId], references: [id])
  epoch        Epoch?      @relation(fields: [epochId], references: [id])
  evalRun      EvalRun?    @relation(fields: [evalRunId], references: [id])

  @@index([bucket])
  @@index([evalRunId])
  @@index([isDemo])
}

// Rubric axes aligned to the project's four scored dimensions.
// NOTE: creativeDepth was renamed to culturalNormAdherence (Sonja's correction).
// Scale: 0-5 (0 = completely wrong). null = N/A (axis not relevant to this prompt).
// rubricVersion partitions data if the rubric ever changes mid-project.
model RubricScore {
  id                          String      @id @default(cuid())
  promptId                    String
  modelOutputId               String
  bucket                      EvalBucket?
  culturalAccuracy            Int? // 0-5, null = N/A
  linguisticAuthenticity      Int? // 0-5, null = N/A
  culturalNormAdherence       Int? // 0-5, null = N/A (was creativeDepth)
  factualCorrectness          Int? // 0-5, null = N/A
  rubricVersion               String      @default("v1")
  notesCulturalAccuracy       String?
  notesLinguisticAuthenticity String?
  notesCulturalNormAdherence  String?
  notesFactualCorrectness     String?
  confidence                  Int? // optional 1-4 confidence in the scoring
  annotatorId                 String
  epochId                     String?
  evalRunId                   String?
  isDemo                      Boolean     @default(false)
  demoSessionId               String?
  createdAt                   DateTime    @default(now())

  modelOutput ModelOutput @relation(fields: [modelOutputId], references: [id])
  annotator   User        @relation(fields: [annotatorId], references: [id])
  epoch       Epoch?      @relation(fields: [epochId], references: [id])
  evalRun     EvalRun?    @relation(fields: [evalRunId], references: [id])

  @@index([evalRunId])
}

// Rubric v2 (Lydia's revised rubric, 2026-07): one row per scored axis.
// Axes are DATA, not columns, so the Monday rubric-lock meeting can rename,
// add, or drop axes without a migration. The axis catalogue lives in
// src/lib/buckets.ts (RUBRIC_V2). Scale 0-5 (0 = completely wrong),
// null = N/A (axis not relevant to this prompt).
model RubricAxisScore {
  id            String      @id @default(cuid())
  promptId      String
  modelOutputId String
  bucket        EvalBucket?
  axis          String // RUBRIC_V2 key, e.g. syntax, diacritics, contamination
  score         Int? // 0-5, null = N/A
  note          String?
  rubricVersion String      @default("v2")
  annotatorId   String
  epochId       String?
  evalRunId     String?
  isDemo        Boolean     @default(false)
  demoSessionId String?
  createdAt     DateTime    @default(now())

  modelOutput ModelOutput @relation(fields: [modelOutputId], references: [id])
  annotator   User        @relation(fields: [annotatorId], references: [id])

  @@index([modelOutputId])
  @@index([axis])
  @@index([isDemo])
}

// Agnes's direct-edit field as a first-class object (gold SFT target).
model OutputEdit {
  id                 String             @id @default(cuid())
  modelOutputId      String
  promptId           String
  bucket             EvalBucket?
  originalText       String // model output as shown: NFC(ModelOutput.outputText) since 2026-08-26 (the editing ground)
  correctedText      String // annotator's corrected Igala
  rationale          String?
  // Span-level suggestions (the editing ground). Versioned envelope:
  //   { v: 1, segments: [{ start, end, original, replacement, reason, reasonTags }] }
  // Offsets are UTF-16 code units into NFC(originalText). correctedText remains
  // the single source of truth for training; segments are ENRICHMENT - the
  // server validates that applying them to originalText reproduces correctedText
  // exactly and DROPS them (never the edit) if they do not. Reason tag keys are
  // CONFIG (EDIT_REASON_TAGS in src/lib/failure-tags.ts), not schema.
  segments           Json?
  provenance         String? // model_correction | salvage_both_inadequate
  consentBenchmark   Boolean            @default(true) // may enter the public benchmark
  consentTraining    Boolean            @default(true) // may enter training sets
  annotatorId        String
  verificationStatus VerificationStatus @default(single_annotator)
  epochId            String?
  isDemo             Boolean            @default(false)
  demoSessionId      String?
  createdAt          DateTime           @default(now())

  modelOutput ModelOutput @relation(fields: [modelOutputId], references: [id])
  annotator   User        @relation(fields: [annotatorId], references: [id])
  epoch       Epoch?      @relation(fields: [epochId], references: [id])

  @@index([modelOutputId])
  @@index([verificationStatus])
  @@index([isDemo])
}

// The annotator's OWN answer, authored BEFORE any model output is revealed
// (source-free gold). An edit inherits the translationese of the text it edits;
// a cold answer does not. This is the anti-translationese signal.
model ColdAuthorAnswer {
  id                 String             @id @default(cuid())
  promptId           String
  bucket             EvalBucket?
  answerText         String
  // Plain-English "what it means / why" gloss for the Igala answer. Training
  // metadata (audit/filter) only — never merged into the Igala answer itself.
  englishGloss       String?
  // The prompt/instruction itself rewritten in Igala by the speaker, so one
  // episode can mint two training rows (English-instruction -> Igala and
  // Igala-instruction -> Igala). Optional, never blocks locking.
  instructionIg      String?
  // Which Igala variety this answer is written in. Free text, not an enum: the
  // option list (IGALA_DIALECTS in src/lib/dialects.ts) is PROVISIONAL and
  // awaiting confirmation from the linguistics and community leads.
  dialect            String?
  provenance         String             @default("speaker_authored_sourcefree")
  consentBenchmark   Boolean            @default(true)
  consentTraining    Boolean            @default(true)
  annotatorId        String
  verificationStatus VerificationStatus @default(single_annotator)
  epochId            String?
  isDemo             Boolean            @default(false)
  demoSessionId      String?
  createdAt          DateTime           @default(now())

  prompt    Prompt @relation(fields: [promptId], references: [id])
  annotator User   @relation(fields: [annotatorId], references: [id])

  @@index([promptId])
  @@index([annotatorId])
  @@index([isDemo])
}

// An annotator flags a prompt as malformed / untranslatable so it can be culled.
// Shaping the instrument is part of the annotator's role.
model PromptFlag {
  id          String   @id @default(cuid())
  promptId    String
  annotatorId String
  reason      String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  prompt    Prompt @relation(fields: [promptId], references: [id])
  annotator User   @relation(fields: [annotatorId], references: [id])

  @@index([promptId])
}

// A researcher-launched walkthrough. Records created under it carry isDemo=true and
// the demoSessionId, and are excluded from training exports, the leaderboard, and
// fine-tune source selection. This is the "run a live demo without polluting data" seam.
model DemoSession {
  id          String    @id @default(cuid())
  label       String
  createdById String?
  notes       String?
  createdAt   DateTime  @default(now())
  endedAt     DateTime?
}

// Holistic cost ledger: every dollar the instrument spends, in one place —
// Together fine-tune training, eval generation, judge calls, ad-hoc inference.
model CostEntry {
  id          String       @id @default(cuid())
  category    CostCategory
  provider    String // together, openai, anthropic, google
  label       String
  amountUsd   Float
  estimated   Boolean      @default(true) // true = derived from token counts + pricing table
  refType     String? // fine_tune_job | eval_run | ...
  refId       String?
  createdById String?
  createdAt   DateTime     @default(now())

  @@index([category])
  @@index([refType, refId])
}

// ─── Handoff / escalation from the learner pipeline ──────────

model HandoffItem {
  id                 String             @id @default(cuid())
  learnerRequest     String
  modelAnswer        String
  confidenceScore    Float
  reviewerReasoning  String?
  gapBucket          EvalBucket?
  status             HandoffStatus      @default(pending)
  correctedAnswer    String?
  reviewerId         String?
  verificationStatus VerificationStatus @default(seed)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  reviewedAt         DateTime?

  pipelineRunId String?      @unique
  reviewer      User?        @relation("ReviewedBy", fields: [reviewerId], references: [id])
  pipelineRun   PipelineRun? @relation(fields: [pipelineRunId], references: [id])
}

// ─── Epochs (the flywheel clock) ─────────────────────────────

model Epoch {
  id                     String    @id @default(cuid())
  epochNumber            Int
  language               String    @default("igala")
  trigger                String // manual, correction_threshold, scheduled
  ragSnapshotId          String?
  promptCatalogueVersion String?
  startedAt              DateTime  @default(now())
  completedAt            DateTime?
  notes                  String?

  modelOutputs        ModelOutput[]
  pairwiseComparisons PairwiseComparison[]
  rubricScores        RubricScore[]
  outputEdits         OutputEdit[]
  fineTuneJobs        FineTuneJob[]
  evalRuns            EvalRun[]

  @@unique([epochNumber, language])
}

// ─── Researcher Model Arena ──────────────────────────────────

enum CandidateKind {
  baseline // frontier API, no adaptation
  rag // base + retrieval
  sft // supervised fine-tune from edits
  dpo // preference fine-tune from pairwise
  continued_pretrain // CPT checkpoint
  composite // e.g. CPT base + DPO adapter + RAG
}

enum FineTuneMethod {
  sft
  dpo
  continued_pretrain
}

enum FineTuneStatus {
  draft
  building_dataset
  uploading
  queued
  running
  succeeded
  failed
  cancelled
  registered
}

enum EvalRunStatus {
  draft
  generating
  awaiting_human
  judging
  aggregating
  complete
  failed
}

enum EvalTrigger {
  manual
  post_finetune
  scheduled
  epoch_rollover
}

// A candidate is a fully-specified, reproducible generation recipe.
model CandidateModel {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  family          String // claude, gpt, gemini, gemma, aya, lugha-llama
  versionLabel    String?
  kind            CandidateKind
  language        String        @default("igala")

  // config (everything needed to reproduce a generation)
  baseModelId     String // provider model id
  provider        String        @default("anthropic") // anthropic, openai, google, openai-compatible
  apiEndpoint     String? // null = platform default router
  hfRepo          String?
  adapterUri      String? // LoRA/DPO adapter location, null for full FT
  systemPrompt    String?
  useSystemPrompt Boolean       @default(false)
  ragEnabled      Boolean       @default(false)
  ragSnapshotId   String?
  decodingParams  Json? // {temperature, topP, maxTokens}

  // lineage / provenance
  fineTuneSource    String?
  fineTuneJobId     String?         @unique
  parentCandidateId String?

  color       String? // viz color
  isPublic    Boolean  @default(false) // visible on public leaderboard
  isChampion  Boolean  @default(false)
  archived    Boolean  @default(false)
  // Member of the annotation pairing pool (2026-08-20 pivot): pairwise episodes
  // draw ONLY from outputs of pool arms. A DB flag, never a hardcoded slug list
  // in routes/UI (house rule) - membership changes are data edits, not deploys.
  inPairingPool Boolean @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fineTuneJob     FineTuneJob?     @relation("JobOutput", fields: [fineTuneJobId], references: [id])
  parent          CandidateModel?  @relation("Lineage", fields: [parentCandidateId], references: [id])
  children        CandidateModel[] @relation("Lineage")
  modelOutputs    ModelOutput[]
  evalRuns        EvalRun[]
  jobsTrainedFrom FineTuneJob[]    @relation("JobBase")

  @@index([language, archived])
}

model FineTuneJob {
  id                String         @id @default(cuid())
  method            FineTuneMethod
  provider          String // openai, together, fireworks, vertex, modal
  baseModelId       String
  baseCandidateId   String?
  language          String         @default("igala")
  trainingFormat    String // openai-chat, dpo-pairs, raw-text-cpt
  systemPrompt      String?

  // data lineage: which collected annotations built the set
  sourcePairwiseIds String[]     @default([])
  sourceEditIds     String[]     @default([])
  sourceRubricIds   String[]     @default([])
  holdoutPromptIds  String[]     @default([])
  bucketFilter      EvalBucket[] @default([])
  nTrainingRows     Int?
  datasetUri        String?
  hyperparameters   Json?

  providerJobId  String?
  providerFileId String?
  status         FineTuneStatus @default(draft)
  errorMessage   String?
  costUsd        Float?
  epochId        String?

  triggeredById String?
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  baseCandidate   CandidateModel? @relation("JobBase", fields: [baseCandidateId], references: [id])
  outputCandidate CandidateModel? @relation("JobOutput")
  epoch           Epoch?          @relation(fields: [epochId], references: [id])

  @@index([status, language])
}

model EvalRun {
  id               String        @id @default(cuid())
  candidateModelId String
  language         String        @default("igala")
  promptSetLabel   String
  holdoutPromptIds String[]      @default([])
  judgeModel       String? // null = human-only run
  positionSwap     Boolean       @default(true)
  status           EvalRunStatus @default(draft)
  trigger          EvalTrigger   @default(manual)
  epochId          String?

  // denormalized roll-ups
  nPrompts       Int     @default(0)
  winRate        Float?
  meanRubric     Float?
  meanRank       Float?
  costUsd        Float?
  configSnapshot Json?
  published      Boolean @default(false)

  triggeredById String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  candidateModel      CandidateModel       @relation(fields: [candidateModelId], references: [id])
  epoch               Epoch?               @relation(fields: [epochId], references: [id])
  scores              EvalScore[]
  modelOutputs        ModelOutput[]
  pairwiseComparisons PairwiseComparison[]
  rubricScores        RubricScore[]

  @@index([candidateModelId, status])
}

model EvalScore {
  id        String     @id @default(cuid())
  evalRunId String
  bucket    EvalBucket
  promptId  String? // null = bucket-level aggregate row

  // per-prompt result (promptId set)
  modelOutputId         String?
  candidateWon          Boolean?
  candidateRank         Int?
  humanScore            Float?
  judgeScore            Float?
  judgeRationale        String?
  positionSwapAgreement Boolean?
  confidence            Float?
  rawJudgePayload       Json?

  // bucket-level aggregate (promptId null)
  btStrength      Float? // Bradley-Terry latent strength
  btCiLow         Float?
  btCiHigh        Float?
  bucketWinRate   Float?
  bucketMeanScore Float?
  bucketN         Int?
  distinguishable Boolean? // false = not enough signal to rank

  createdAt DateTime @default(now())

  evalRun EvalRun @relation(fields: [evalRunId], references: [id])

  @@index([evalRunId, bucket])
}

// ─── Phase C: Conversational AI ──────────────────────────────

model Conversation {
  id        String   @id @default(cuid())
  learnerId String?
  language  String   @default("igala")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  role            String
  content         String
  source          String
  confidenceScore Float?
  pipelineRunId   String?  @unique
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  pipelineRun  PipelineRun? @relation
}

model PipelineRun {
  id                  String   @id @default(cuid())
  messageId           String   @unique
  candidateModelId    String?
  translatorModel     String
  translatorOutput    String
  translatorLatencyMs Int?
  reviewerOutput      String?
  reviewerConfidence  Float?
  reviewerReasoning   String?
  ragContextIds       String[]
  retryCount          Int      @default(0)
  finalDisposition    String
  gapBucket           String?
  createdAt           DateTime @default(now())

  message     Message      @relation(fields: [messageId], references: [id])
  handoffItem HandoffItem?
}

// ─── RAG knowledge base ──────────────────────────────────────

model RagEntry {
  id                 String                      @id @default(cuid())
  language           String                      @default("igala")
  chunkType          String
  topic              String
  content            String
  source             String
  verificationStatus String                      @default("seed")
  annotatorId        String?
  embedding          Unsupported("vector(1536)")?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  history RagEntryHistory[]
}

model RagEntryHistory {
  id         String   @id @default(cuid())
  ragEntryId String
  content    String
  editedById String?
  reason     String?
  createdAt  DateTime @default(now())

  ragEntry RagEntry @relation(fields: [ragEntryId], references: [id])
}

// ── RAG v2 data layer (2026-08-12) ──────────────────────────────────────────
// Agnes's live test: words are Igala, sentences incoherent. Word lists cannot
// teach structure; parallel sentences can. BSN Bible permission via Lydia.

model LexEntry {
  id             String   @id @default(cuid())
  headword       String // Igala, standard orthography
  headwordFolded String // fullFold, for lookup
  gloss          String // English
  glossFolded    String // fullFold, the retrieval key (English side)
  pos            String?
  source         String // provenance + permission trail
  confidence     Float    @default(1) // 1.0 curated, alignment-induced lower
  exampleIg      String?
  exampleEn      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([headword, gloss, source])
  @@index([glossFolded])
  @@index([headwordFolded])
}

model ParallelPair {
  id        String   @id @default(cuid())
  igala     String
  english   String
  source    String // provenance + permission trail
  ref       String? // e.g. verse reference
  createdAt DateTime @default(now())

  // englishTsv (generated tsvector + GIN index) exists in the DB for
  // lexical-overlap retrieval but is deliberately not mapped here - Prisma
  // must never try to write a generated column. Query it with $queryRaw.
  @@unique([source, ref])
}
